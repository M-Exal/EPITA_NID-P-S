# ============================================================================
#  Variables d'environnement — NIDS / NIPS
#  Copiez ce fichier en .env et renseignez vos valeurs.
# ============================================================================

# --- Discord Webhook (Notifications d'intrusion) ---
# Créez un webhook dans Discord : Paramètres du serveur > Intégrations > Webhooks
# Collez l'URL ici :
DISCORD_WEBHOOK_URL=

# --- Resend API (Recommandé pour contourner les blocages SMTP FAI/Cloud) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=votre-email@example.com
ALERT_EMAIL_FROM=CyBear NIDS <onboarding@resend.dev>

# --- Email SMTP Fallback (Rapport chiffré et alertes critiques) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_SENDER=
REPORT_RECEIVER=

# --- Chiffrement ---
NIDS_FERNET_KEY=
