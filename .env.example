# ============================================================================
#  .env.example — Configuration de la démonstration (copier vers .env)
#
#    cp .env.example .env
#
#  Ce fichier est lu par Docker Compose puis transmis au conteneur NIDS.
#  Il est facultatif : sans lui, la démonstration fonctionne, seul l'envoi
#  du rapport chiffré par courriel est ignoré.
# ============================================================================

# ---------------------------------------------------------------------- #
#  Envoi du rapport chiffré par courriel (SMTP)
# ---------------------------------------------------------------------- #
# Gmail : activer la validation en 2 étapes puis créer un
# "mot de passe d'application" (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre adresse@gmail.com
SMTP_PASSWORD=mot de passe d application

# Expéditeur / destinataire du rapport.
REPORT_SENDER=votre adresse@gmail.com
REPORT_RECEIVER=destinataire@example.com

# ---------------------------------------------------------------------- #
#  Chiffrement du rapport (Fernet)
# ---------------------------------------------------------------------- #
# Laisser vide : une clé est générée dans data/nids/secret.key.
# Pour partager la même clé entre l'émetteur et le destinataire, coller ici
# la valeur générée (ou en obtenir une avec : python3 nids/crypto_utils.py genkey).
NIDS_FERNET_KEY=

# ---------------------------------------------------------------------- #
#  Seuils du NIDS (valeurs par défaut, à ajuster selon les tests)
# ---------------------------------------------------------------------- #
# Nombre de ports distincts contactés avant alerte SCAN_PORTS.
NIDS_SCAN_THRESHOLD=15
# Nombre de paquets reçus d'une même IP avant alerte DOS.
NIDS_DOS_THRESHOLD=200
# Nombre de connexions (SYN) vers SSH/Telnet avant alerte BRUTE_FORCE.
NIDS_BRUTE_THRESHOLD=10
