# ============================================================================
#  Variables d'environnement — NIDS / NIPS
#  Copiez ce fichier en .env et renseignez vos valeurs.
# ============================================================================

# --- Discord Webhook (Notifications d'intrusion) ---
# Créez un webhook dans Discord : Paramètres du serveur > Intégrations > Webhooks
# Collez l'URL ici :
DISCORD_WEBHOOK_URL=

# --- Email (Rapport chiffré) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_SENDER=
REPORT_RECEIVER=

# --- Chiffrement ---
NIDS_FERNET_KEY=
